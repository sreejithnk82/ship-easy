# Copy to .env and fill in. These are baked into the build (public values only).

# The Apps Script Web App /exec URL (Deploy ▸ Web app).
VITE_WEBAPP_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Google OAuth Web client id (Google Cloud Console ▸ Credentials).
# Must match the OAUTH_CLIENT_ID Script Property on the backend.
VITE_GOOGLE_CLIENT_ID=XXXXXXXX.apps.googleusercontent.com
